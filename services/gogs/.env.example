# Gogs service configuration.
# Copy to .env and edit (or run: just bootstrap). Comments are safe to keep.
#
# Required before first start:
#   - GOGS_DOMAIN / GOGS_EXTERNAL_URL: values users actually reach
#   - GOGS_SECURITY_SECRET_KEY: generate with: openssl rand -hex 32

# Host HTTP port -> container 3000 (3000 is too common; high default port)
GOGS_HTTP_PORT=8550

# Host/IP users actually reach. Production: the Linux VM LAN IP.
GOGS_DOMAIN=change-me.local
# Full URL users open. Keep the port in sync with GOGS_HTTP_PORT.
GOGS_EXTERNAL_URL=http://change-me.local:8550/

# Strong random secret. Env-injected only — never written into app.ini on disk.
GOGS_SECURITY_SECRET_KEY=change-me

# Data dir: container data, relative to services/gogs/ (the compose dir) ->
# repo-root data/gogs. Absolute paths allowed (e.g. external storage on the VM).
GOGS_DATA_DIR=../../data/gogs

# Backup: output dir (under the same data/ umbrella: data/backups/gogs) + how
# many recent backups to keep. Absolute paths allowed (e.g. NAS).
GOGS_BACKUP_DIR=../../data/backups/gogs
GOGS_BACKUP_KEEP=5
